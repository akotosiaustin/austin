    print(' print(f"Hello {name}, you are {age} years old!")\n')
    
    print(" Remember: input() ALWAYS gives text. Use int() or float() if you need numbers!\n")
    input("Press Enter to return to the main menu...")


def lesson_5():
    print("\n" + "=" * 50)
    print("      LESSON 5: Conditional Statements      ")
    print("=" * 50)
    print(" Make decisions with if / elif / else\n")
    print(" Structure:")
    print(' if condition:')
    print('     do something')
    print(' elif another condition:')
    print('     do something else')
    print(' else:')
    print('     do this when none are true\n')
    
    print(" Comparison Operators:")
    print("   ==  Equal to        !=  Not equal to")
    print("   >   Greater than    <   Less than")
    print("   >=  Greater or equal  <=  Less or equal\n")
    
    print(" Example:")
    print(' score = 85')
    print(' if score >= 75:')
    print('     print("Passed! ")')
    print(' else:')
    print('     print("Failed ")\n')
    
    input("Press Enter to return to the main menu...")


def lesson_6():
    print("\n" + "=" * 50)
    print("           LESSON 6: Logical Operators           ")
    print("=" * 50)
    print(" Combine conditions — and, or, not\n")
    
    print("and → Both conditions must be TRUE")
    print(' age = 20')
    print(' if age >= 13 and age <= 19:')
    print('     print("Teenager")')
    print(' else:')
    print('     print("Not a teenager")\n')
    
    print("or → At least one condition is TRUE")
    print(' if day == "Sat" or day == "Sun":')
    print('     print("Weekend! ")\n')
    
    print("not → Reverses the condition")
    print(' if not is_raining:')
    print('     print("Go outside! ☀")\n')
    
    print(" Quick Summary:")
    print("   and = ALL true | or = ANY true | not = Flip n")
    
    input("Press Enter to return to the main menu...")


def lesson_7():
    print("\n" + "=" * 50)
    print(" LESSON 7: Introduction to Iteration and Loops ")
    print("=" * 50)
    print(" Loops let you repeat code without typing it again!\n")
    
    print(" 1. while loop — repeats AS LONG AS condition is TRUE")
    print(' count = 1')
    print(' while count <= 5:')
    print('     print(count)')
    print('     count += 1')
    print(' # Output: 1 2 3 4 5\n')
    
    print(" 2. for loop — repeats FOR each item in a sequence")
    print(' for number in range(1, 6):')
    print('     print(number)')
    print(' # Output: 1 2 3 4 5\n')
    
    print("️ Important: Don't forget to stop the loop! Otherwise it runs forever.\n")
    
    input("Press Enter to return to the main menu...")


def run_quiz():
    print("\n" + "=" * 50)
    print("           PYTHON KNOWLEDGE QUIZ          ")
    print("=" * 50)
    score = 0
    
    # Question 1
    print("\n1. Which symbol is used for comments in Python?")
    print("   a) //   b) #   c) /* */")
    ans = input("Your answer: ").strip().lower()
    if ans == 'b':
        print("Correct!")
        score += 1
    else:
        print("Wrong! The correct answer is: b) #")
    
    # Question 2
    print("\n2. Which operator means 'equal to'?")
    print("   a) =   b) ==   c) ===")
    ans = input("Your answer: ").strip().lower()
    if ans == 'b':
        print("Correct!")
        score += 1
    else:
        print("Wrong! The correct answer is: b) ==")
    
    # Question 3
    print("\n3. Which loop repeats as long as a condition is true?")
    print("   a) while   b) for   c) repeat")
    ans = input("Your answer: ").strip().lower()
    if ans == 'a':
        print("Correct!")
        score += 1
    else:
        print("Wrong! The correct answer is: a) while")
    
    # Question 4
    print("\n4. What function do you use to get input from the user?")
    print("   a) get_input()   b) input()   c) read()")
    ans = input("Your answer: ").strip().lower()
    if ans == 'b':
        print("Correct!")
        score += 1
    else:
        print("Wrong! The correct answer is: b) input()")
    
    # Question 5
    print("\n5. Which symbol is used for multiplication in Python?")
    print("   a) x   b) *   c) xor")
    ans = input("Your answer: ").strip().lower()
    if ans == 'b':
        print("Correct!")
        score += 1
    else:
        print("Wrong! The correct answer is: b) *")
    
    print("\n" + "-" * 50)
    print(f" Quiz Complete! Your Score: {score}/5")
    print("-" * 50)
    input("\nPress Enter to return to the main menu...")


