def lesson_4():
    print("\n" + "=" * 50)
    print("    LESSON 4: Basic Input and Output in Python    ")
    print("=" * 50)
    print(" Output — print() function")
    print(' print("Hi there!")')
    print(' print("Hello", "World")  # Automatically adds space\n')
    
    print(" Input — input() function")
    print(' name = input("Enter your name: ")  # Gets text')
    print(' age = int(input("Enter your age: "))  # Gets number\n')
    
